# Environment for Open Game Master (mirrors docker-compose.yml's environment block)
ODM_HOST_PORT=3005
ODM_SETUP_CODE=REPLACE_ME
DEFAULT_TEXT_PROVIDER=custom
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPAT_MODEL=game-master
OPENAI_COMPAT_API_KEY=REPLACE_ME
OPENAI_COMPAT_CONTEXT=65536
COMFYUI_URL=http://127.0.0.1:8188
KOKORO_URL=http://127.0.0.1:8880
TTS_PROVIDER=kokoro
TTS_VOICE=af_heart
STT_URL=off
APP_PUBLIC_URL=https://YOUR_POD_ID-3005.proxy.runpod.net
COOKIE_SECURE=1
VOICE_ENABLED=0
