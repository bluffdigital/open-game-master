{{- bos_token }}
{%- if custom_tools is defined %}
    {%- set tools = custom_tools %}
{%- endif %}
{%- if not tools_in_user_message is defined %}
    {#- OGM: tools go in the system message; OGM histories are long and the first user turn can be far back. #}
    {%- set tools_in_user_message = false %}
{%- endif %}
{%- if not date_string is defined %}
    {%- if strftime_now is defined %}
        {%- set date_string = strftime_now("%d %b %Y") %}
    {%- else %}
        {%- set date_string = "26 Jul 2024" %}
    {%- endif %}
{%- endif %}
{%- if not tools is defined %}
    {%- set tools = none %}
{%- endif %}

{#- This block extracts the system message, so we can slot it into the right place. #}
{%- if messages[0]['role'] == 'system' %}
    {%- if messages[0]['content'] is string %}
        {%- set system_message = messages[0]['content']|trim %}
    {%- else %}
        {%- set system_message = messages[0]['content'] | selectattr('type', 'equalto', 'text') | map(attribute='text') | join('\n') | trim %}
    {%- endif %}
    {%- set messages = messages[1:] %}
{%- else %}
    {%- if tools is not none %}
        {%- set system_message = "You are a helpful assistant with tool calling capabilities. Only reply with a tool call if the function exists in the library provided by the user. If it doesn't exist, just reply directly in natural language. When you receive a tool call response, use the output to format an answer to the original user question." %}
    {%- else %}
        {%- set system_message = "" %}
    {%- endif %}
{%- endif %}

{#- OGM patches (ported from qwen36-ogm.jinja v5): JSON-only reminder for utility prompts, and a state/gold/agency
     reminder on DM turns that are offered grant_item or learn_spell. #}
{%- set ogm_json = ('Reply with ONLY a' in system_message) or ('Reply with only a JSON' in system_message) %}
{%- set ogm_t = namespace(state=false) %}
{%- if tools is not none and tools is iterable and tools is not mapping %}
    {%- for t in tools %}
        {%- set f = t.function if t.function is defined else t %}
        {%- if f.name is defined and f.name in ['grant_item', 'learn_spell'] %}
            {%- set ogm_t.state = true %}
        {%- endif %}
    {%- endfor %}
{%- endif %}
{%- set ogm_json_note = '\n\n(When you answer, reply with ONLY the JSON described in the system message: no prose, no headings, no code fences.)' %}
{%- set ogm_state_note = '\n\n(GM reminder: narration alone changes nothing on a sheet. If this action gains or loses an item, coins, or a spell, call the matching tool and narrate what its result says. learn_spell and purchase take their own gold cost: never add modify_gold for a spell copy or a price. Use modify_gold only for coins that change hands by themselves (found, given, stolen, paid for a service), and never repeat a grant or payment from an earlier turn. When a tool result says nothing changed, nothing was spent. Player characters belong to their players: never write their words, thoughts or choices beyond what the player declared.)' %}

{#- System message #}
{{- "<|start_header_id|>system<|end_header_id|>\n\n" }}
{%- if tools is not none %}
    {{- "Environment: ipython\n" }}
{%- endif %}
{{- "Cutting Knowledge Date: December 2023\n" }}
{{- "Today Date: " + date_string + "\n\n" }}
{%- if tools is not none and not tools_in_user_message %}
    {{- "You have access to the following functions. To call a function, please respond with JSON for a function call. " }}
    {{- 'Respond in the format {"name": function name, "parameters": dictionary of argument name and its value}, with nothing before or after it. ' }}
    {{- "Do not use variables.\n\n" }}
    {%- for t in tools %}
        {#- OGM: list the bare function (name/description/parameters); with the {"type":"function"} wrapper Llama 3.3 copied the wrapper into its calls. #}
        {{- (t.function if t.function is defined else t) | tojson(indent=4) }}
        {{- "\n\n" }}
    {%- endfor %}
{%- endif %}
{{- system_message }}
{{- "<|eot_id|>" }}

{#- Custom tools are passed in a user message with some extra guidance #}
{%- if tools_in_user_message and not tools is none %}
    {#- Extract the first user message so we can plug it in here #}
    {%- if messages | length != 0 %}
        {%- if messages[0]['content'] is string %}
            {%- set first_user_message = messages[0]['content']|trim %}
        {%- else %}
            {%- set first_user_message = messages[0]['content'] | selectattr('type', 'equalto', 'text') | map(attribute='text') | map('trim') | join('\n') %}
        {%- endif %}
        {%- set messages = messages[1:] %}
    {%- else %}
        {{- raise_exception("Cannot put tools in the first user message when there's no first user message!") }}
    {%- endif %}
    {{- '<|start_header_id|>user<|end_header_id|>\n\n' -}}
    {{- "Given the following functions, please respond with a JSON for a function call " }}
    {{- "with its proper arguments that best answers the given prompt.\n\n" }}
    {{- 'Respond in the format {"name": function name, "parameters": dictionary of argument name and its value}, with nothing before or after it. ' }}
    {{- "Do not use variables.\n\n" }}
    {%- for t in tools %}
        {#- OGM: list the bare function (name/description/parameters); with the {"type":"function"} wrapper Llama 3.3 copied the wrapper into its calls. #}
        {{- (t.function if t.function is defined else t) | tojson(indent=4) }}
        {{- "\n\n" }}
    {%- endfor %}
    {{- first_user_message + "<|eot_id|>"}}
{%- endif %}

{%- for message in messages %}
    {%- set has_calls = message.tool_calls is defined and message.tool_calls and message.tool_calls|length > 0 %}
    {%- if not (message.role == 'ipython' or message.role == 'tool' or has_calls) %}
        {{- '<|start_header_id|>' + message['role'] + '<|end_header_id|>\n\n' }}
        {%- if message['content'] is none %}
        {%- elif message['content'] is string %}
            {{- message['content'] | trim}}
        {%- else %}
            {%- for content in message['content'] %}
                {%- if content['type'] == 'text' %}
                    {{- content['text'] | trim }}
                {%- endif %}
            {%- endfor %}
        {%- endif %}
        {%- if loop.last and add_generation_prompt and message.role == 'user' %}
            {%- set utext = message['content'] if message['content'] is string else '' %}
            {%- if ogm_json %}
                {{- ogm_json_note }}
            {%- elif ogm_t.state and not utext.startswith('[System]') %}
                {{- ogm_state_note }}
            {%- endif %}
        {%- endif %}
        {{- '<|eot_id|>' }}
    {%- elif has_calls %}
        {#- OGM: render every call (the stock template refused more than one). #}
        {%- for tc in message.tool_calls %}
            {%- set tool_call = tc.function if tc.function is defined else tc %}
            {{- '<|start_header_id|>assistant<|end_header_id|>\n\n' -}}
            {{- '{"name": "' + tool_call.name + '", ' }}
            {{- '"parameters": ' }}
            {%- if tool_call.arguments is string %}
                {{- tool_call.arguments }}
            {%- else %}
                {{- tool_call.arguments | tojson }}
            {%- endif %}
            {{- "}" }}
            {{- "<|eot_id|>" }}
        {%- endfor %}
    {%- elif message.role == "tool" or message.role == "ipython" %}
        {{- "<|start_header_id|>ipython<|end_header_id|>\n\n" }}
        {%- if message.content is string %}
            {{- { "output": message.content } | tojson }}
        {%- else %}
            {%- for content in message['content']  %}
                {%- if content['type']  == 'text' %}
                    {{- { "output": content['text']  } | tojson }}
                {%- endif %}
            {%- endfor %}
        {%- endif %}
        {{- "<|eot_id|>" }}
    {%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
    {{- '<|start_header_id|>assistant<|end_header_id|>\n\n' }}
{%- endif %}
